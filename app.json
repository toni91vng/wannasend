{
  "expo": {
    "name": "WannaSend",
    "slug": "wannasend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wannasend.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5DB075",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wannasend.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.wannasend",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "WannaSend usa tus fotos para que puedas adjuntar la foto del paquete.",
          "cameraPermission": "WannaSend usa la cámara para hacer la foto del paquete al enviarlo y al recogerlo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5DB075"
        }
      ],
      "./plugins/withDisableReleaseLint",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Stripe: push provisioning (tarjetas emitidas) no se usa y su librería no es pública\n-dontwarn com.stripe.android.pushProvisioning.**"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "wannasend",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "stanarge",
    "extra": {
      "eas": {
        "projectId": "6bd1efdb-c51e-4543-9fb4-93d4a121b5b2"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6bd1efdb-c51e-4543-9fb4-93d4a121b5b2"
    }
  }
}